{
  "name": "omcp-cli",
  "version": "0.1.0",
  "description": "Profile-based MCP manager and launcher for OpenCode. Turn MCP servers on and off per workflow instead of paying the context cost of all of them.",
  "type": "module",
  "bin": {
    "omcp": "./dist/cli.js"
  },
  "scripts": {
    "dev": "bun run bin/omcp.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build:node": "bun build bin/omcp.ts --target=node --outfile dist/cli.js",
    "build:binary": "bun build bin/omcp.ts --compile --outfile dist/omcp",
    "build": "bun run build:node && bun run build:binary",
    "prepublishOnly": "bun run typecheck && bun test && bun run build:node"
  },
  "files": [
    "dist/cli.js",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "opencode",
    "mcp",
    "model-context-protocol",
    "cli",
    "profiles",
    "context-window"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@clack/core": "^1.6.0",
    "@clack/prompts": "^1.9.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "typescript": "5.9"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/muhnazih029/omcp.git"
  },
  "homepage": "https://github.com/muhnazih029/omcp#readme",
  "bugs": {
    "url": "https://github.com/muhnazih029/omcp/issues"
  },
  "author": "Muh. Nazih"
}
